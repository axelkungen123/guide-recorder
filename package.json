{
  "name": "guide-recorder-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the guide-recorder spike. Only extension/ exists for now; web/ and api/ come later.",
  "workspaces": [
    "extension"
  ],
  "scripts": {
    "build": "npm run build -w @guide-recorder/extension",
    "dev": "npm run dev -w @guide-recorder/extension",
    "typecheck": "npm run typecheck -w @guide-recorder/extension"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
